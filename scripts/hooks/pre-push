#!/usr/bin/env bash
# ToolTempest-adjacent DocOps hooks (pinned version in .tooltempest.lock)
set -euo pipefail

# Capture the original stdin once, before anything else reads it. Git hands the
# ref updates to pre-push on stdin; a stream can be consumed once, and the pin
# check, the lock guard and the DocOps checker below need them (ADR-0026, ADR-0031). A push that
# updates nothing sends zero bytes. If the capture cannot be made, the push is
# blocked (set -e).
PUSH_CAPTURE="$(mktemp "${TMPDIR:-/tmp}/radar-pre-push.XXXXXX")"
trap 'rm -f "$PUSH_CAPTURE"' EXIT
cat > "$PUSH_CAPTURE"

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ToolTempest pin check (ADR-0031), the first step after the capture above: no
# other step runs unless the lock of every pushed tip, the installed files and the
# install receipt agree with the pinned commit. Zero bytes means the push updates
# nothing: nothing to check. The script is looked up in this worktree only, with
# no fallback to another worktree or clone. Any non-zero exit (1 blocked, 2 usage
# or internal failure) ends the hook with the same exit code. A tip without
# .tooltempest.lock is skipped by the script itself (exit 0). Without the script, a
# push whose pushed refs ever held the lock is blocked (same history test as the
# lock guard below), and any other push is skipped with a message.
if [ -s "$PUSH_CAPTURE" ]; then
  PIN_CHECK="$REPO_ROOT/scripts/tt_pin_check.py"
  if [ -f "$PIN_CHECK" ]; then
    pin_rc=0
    python3 "$PIN_CHECK" push --root "$REPO_ROOT" < "$PUSH_CAPTURE" || pin_rc=$?
    if [ "$pin_rc" -ne 0 ]; then
      echo "[pre-push] ToolTempest pin check failed (exit $pin_rc); push blocked."
      exit "$pin_rc"
    fi
  else
    pin_lock_seen=0
    while read -r _pin_local_ref pin_local_sha _pin_remote_ref _pin_remote_sha; do
      case "$pin_local_sha" in
        *[!0]*) ;;
        *) continue ;;
      esac
      history_rc=0
      lock_history="$(git log -1 --format=%H --full-history "$pin_local_sha" -- .tooltempest.lock < /dev/null)" || history_rc=$?
      if [ "$history_rc" -ne 0 ] || [ -n "$lock_history" ]; then
        pin_lock_seen=1
      fi
    done < "$PUSH_CAPTURE"
    if [ "$pin_lock_seen" -ne 0 ]; then
      echo "[pre-push] scripts/tt_pin_check.py not found in this worktree and a pushed ref holds .tooltempest.lock; push blocked."
      echo "[pre-push] Materialize the ToolTempest core component. From a ToolTempest checkout that contains the commit pinned in .tooltempest.lock, run:"
      echo "[pre-push]   python3 <tooltempest-checkout>/scripts/tooling.py materialize --root '$REPO_ROOT' --source <tooltempest-checkout> --apply"
      exit 1
    fi
    echo "[tt-pin] pre-push: scripts/tt_pin_check.py not found and no pushed ref holds .tooltempest.lock; skipped."
  fi
fi

# Lock integrity guard (ADR-0025). For every pushed ref, verify the
# .tooltempest.lock as it exists in the pushed tip (not the working-tree copy)
# against the materialized vendored file. stdin lines from git:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# The checker is looked up in this worktree first, then in the main worktree
# (hooks are shared by every worktree, and a data-only worktree such as the
# vault one has no scripts/ of its own).
resolve_lock_checker() {
  local common candidate
  common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
  for candidate in "$REPO_ROOT/scripts/check_tooltempest_lock.py" "$(dirname "$common")/scripts/check_tooltempest_lock.py"; do
    if [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

#
# The checker may be missing in both places (for example when the main worktree
# itself is checked out on a data-only branch). That alone must not block a ref
# whose whole history provably never contained the lock; any other ref cannot
# be verified without the checker and blocks the push (fail closed).
lock_guard_failed=0
LOCK_CHECKER=""
if ! LOCK_CHECKER="$(resolve_lock_checker)"; then
  LOCK_CHECKER=""
fi
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *)
      echo "[lock-guard] pre-push: $remote_ref is a ref deletion; nothing to verify."
      continue ;;
  esac
  if [ -n "$LOCK_CHECKER" ]; then
    rc=0
    python3 "$LOCK_CHECKER" --repo-root "$REPO_ROOT" --lock-source "rev:$local_sha" < /dev/null || rc=$?
    case "$rc" in
      0|3) ;;
      *) lock_guard_failed=1 ;;
    esac
  else
    history_rc=0
    lock_history="$(git log -1 --format=%H --full-history "$local_sha" -- .tooltempest.lock < /dev/null)" || history_rc=$?
    if [ "$history_rc" -eq 0 ] && [ -z "$lock_history" ]; then
      echo "N/A: scripts/check_tooltempest_lock.py not found, but $remote_ref has no .tooltempest.lock anywhere in its history; nothing to verify."
    else
      echo "[pre-push] scripts/check_tooltempest_lock.py not found in this or the main worktree; cannot verify $remote_ref; push blocked."
      lock_guard_failed=1
    fi
  fi
done < "$PUSH_CAPTURE"
if [ "$lock_guard_failed" -ne 0 ]; then
  echo "[pre-push] .tooltempest.lock integrity check failed; push blocked."
  exit 1
fi

# DocOps checker (ADR-0026) over the same captured ref updates. Zero bytes means
# the push updates nothing: N/A. Any non-empty input needs the checker, and a
# missing checker or any non-zero exit (1 violation, 2 no verdict, 3 not
# established) blocks the push. Looked up like the lock checker: this worktree
# first, then the main worktree. No network call is made by this hook.
resolve_docops_checker() {
  local common candidate
  common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
  for candidate in "$REPO_ROOT/scripts/docops.py" "$(dirname "$common")/scripts/docops.py"; do
    if [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

if [ ! -s "$PUSH_CAPTURE" ]; then
  echo "[docops] pre-push: no ref updates (zero bytes on stdin); N/A."
elif ! DOCOPS_CHECKER="$(resolve_docops_checker)"; then
  echo "[pre-push] scripts/docops.py not found in this or the main worktree; push blocked."
  echo "[pre-push] Materialize the ToolTempest core component. From a ToolTempest checkout that contains the commit pinned in .tooltempest.lock, run:"
  echo "[pre-push]   python3 <tooltempest-checkout>/scripts/tooling.py materialize --root '$REPO_ROOT' --source <tooltempest-checkout> --apply"
  echo "[pre-push] Procedure: docs/tooltempest/consumer-contract.md in mikkiola/tooltempest."
  exit 1
elif ! python3 "$DOCOPS_CHECKER" check --repo "$REPO_ROOT" --push-stdin < "$PUSH_CAPTURE"; then
  echo "[pre-push] docops check failed; push blocked."
  exit 1
fi

# Secret scan (ADR-0032), the last step: Betterleaks, the scanner of the CI job
# security_secrets, scans the commits this push would publish, never the working
# tree. Zero bytes means the push updates nothing: N/A. A ref deletion publishes no
# commit. A missing scanner, a finding, and any scanner failure block the push (fail
# closed). The output names rule, file, line and commit of a finding and never its
# value: --redact keeps the value out of the report, and only those four fields are
# printed. Scanner configuration variables are removed from the environment so that
# the default rules apply, as in the CI job. No network call is made (no --validation).
# It runs in every worktree, the data-only vault one included, because it needs
# nothing from scripts/.
scan_failed=0
if [ ! -s "$PUSH_CAPTURE" ]; then
  echo "[secret-scan] pre-push: no ref updates (zero bytes on stdin); N/A."
elif ! command -v betterleaks >/dev/null 2>&1; then
  echo "[pre-push] betterleaks not found on PATH; the push cannot be scanned for secrets; push blocked."
  echo "[pre-push] Install it: brew install betterleaks (macOS), or a release from https://github.com/betterleaks/betterleaks/releases (the CI job pins v1.7.3, see .github/workflows/security.yml)."
  exit 1
else
  scan_remotes="--remotes"
  if [ -n "${1:-}" ]; then
    scan_remotes="--remotes=$1"
  fi
  while read -r scan_local_ref scan_local_sha scan_remote_ref scan_remote_sha; do
    case "$scan_local_sha" in
      *[!0]*) ;;
      *)
        echo "[secret-scan] pre-push: $scan_remote_ref is a ref deletion; nothing to scan."
        continue ;;
    esac
    # An existing remote ref: the commits between its old tip and the new tip. A new
    # ref, or an old tip this clone does not hold: everything the remote does not have.
    scan_range="$scan_local_sha --not $scan_remotes"
    case "$scan_remote_sha" in
      *[!0]*)
        if git cat-file -e "$scan_remote_sha^{commit}" < /dev/null 2>/dev/null; then
          scan_range="$scan_remote_sha..$scan_local_sha"
        fi ;;
    esac
    scan_rc=0
    scan_report="$(env -u BETTERLEAKS_CONFIG -u GITLEAKS_CONFIG -u BETTERLEAKS_CONFIG_TOML -u GITLEAKS_CONFIG_TOML \
      betterleaks git "$REPO_ROOT" --no-banner --no-color --redact -f json -r - --log-opts "$scan_range" < /dev/null)" || scan_rc=$?
    # Exit 0 of the parser: no finding. 1: findings, one location per line. 2: no usable report.
    parse_rc=0
    scan_locations="$(printf '%s' "$scan_report" | python3 -c '
import json, sys
try:
    raw = sys.stdin.read()
    findings = json.loads(raw) if raw.strip() else []
    if not isinstance(findings, list):
        raise ValueError("not a list")
    lines = ["[secret-scan]   {} {}:{} commit {}".format(item.get("RuleID", "?"), item.get("File", "?"), item.get("StartLine", "?"), str(item.get("Commit", ""))[:12]) for item in findings]
except Exception:
    sys.exit(2)
for line in lines:
    print(line)
sys.exit(1 if findings else 0)
')" || parse_rc=$?
    if [ "$parse_rc" -eq 1 ]; then
      echo "[secret-scan] $scan_remote_ref: the commits to push contain a potential secret (the value is not printed):"
      echo "$scan_locations"
      scan_failed=1
    elif [ "$parse_rc" -ne 0 ] || [ "$scan_rc" -ne 0 ]; then
      echo "[secret-scan] $scan_remote_ref: scanner exited $scan_rc without a usable report; the commits cannot be verified."
      scan_failed=1
    else
      echo "[secret-scan] pre-push: $scan_remote_ref scanned ($scan_range); no findings."
    fi
  done < "$PUSH_CAPTURE"
fi
if [ "$scan_failed" -ne 0 ]; then
  echo "[pre-push] secret scan failed; push blocked."
  exit 1
fi

echo "[pre-push] All checks passed."
exit 0
