#!/usr/bin/env bash
# ToolTempest-adjacent DocOps hooks (pinned version in .tooltempest.lock)
set -euo pipefail

# Capture the original stdin once, before anything else reads it. Git hands the
# ref updates to pre-push on stdin; a stream can be consumed once, and both the
# lock guard and the DocOps checker below need them (ADR-0026). A push that
# updates nothing sends zero bytes. If the capture cannot be made, the push is
# blocked (set -e).
PUSH_CAPTURE="$(mktemp "${TMPDIR:-/tmp}/radar-pre-push.XXXXXX")"
trap 'rm -f "$PUSH_CAPTURE"' EXIT
cat > "$PUSH_CAPTURE"

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Lock integrity guard (ADR-0025). For every pushed ref, verify the
# .tooltempest.lock as it exists in the pushed tip (not the working-tree copy)
# against the materialized vendored file. stdin lines from git:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# The checker is looked up in this worktree first, then in the main worktree
# (hooks are shared by every worktree, and a data-only worktree such as the
# vault one has no scripts/ of its own).
resolve_lock_checker() {
  local common candidate
  common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
  for candidate in "$REPO_ROOT/scripts/check_tooltempest_lock.py" "$(dirname "$common")/scripts/check_tooltempest_lock.py"; do
    if [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

#
# The checker may be missing in both places (for example when the main worktree
# itself is checked out on a data-only branch). That alone must not block a ref
# whose whole history provably never contained the lock; any other ref cannot
# be verified without the checker and blocks the push (fail closed).
lock_guard_failed=0
LOCK_CHECKER=""
if ! LOCK_CHECKER="$(resolve_lock_checker)"; then
  LOCK_CHECKER=""
fi
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *)
      echo "[lock-guard] pre-push: $remote_ref is a ref deletion; nothing to verify."
      continue ;;
  esac
  if [ -n "$LOCK_CHECKER" ]; then
    rc=0
    python3 "$LOCK_CHECKER" --repo-root "$REPO_ROOT" --lock-source "rev:$local_sha" < /dev/null || rc=$?
    case "$rc" in
      0|3) ;;
      *) lock_guard_failed=1 ;;
    esac
  else
    history_rc=0
    lock_history="$(git log -1 --format=%H --full-history "$local_sha" -- .tooltempest.lock < /dev/null)" || history_rc=$?
    if [ "$history_rc" -eq 0 ] && [ -z "$lock_history" ]; then
      echo "N/A: scripts/check_tooltempest_lock.py not found, but $remote_ref has no .tooltempest.lock anywhere in its history; nothing to verify."
    else
      echo "[pre-push] scripts/check_tooltempest_lock.py not found in this or the main worktree; cannot verify $remote_ref; push blocked."
      lock_guard_failed=1
    fi
  fi
done < "$PUSH_CAPTURE"
if [ "$lock_guard_failed" -ne 0 ]; then
  echo "[pre-push] .tooltempest.lock integrity check failed; push blocked."
  exit 1
fi

# DocOps checker (ADR-0026) over the same captured ref updates. Zero bytes means
# the push updates nothing: N/A. Any non-empty input needs the checker, and a
# missing checker or any non-zero exit (1 violation, 2 no verdict, 3 not
# established) blocks the push. Looked up like the lock checker: this worktree
# first, then the main worktree. No network call is made by this hook.
resolve_docops_checker() {
  local common candidate
  common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
  for candidate in "$REPO_ROOT/scripts/docops.py" "$(dirname "$common")/scripts/docops.py"; do
    if [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

if [ ! -s "$PUSH_CAPTURE" ]; then
  echo "[docops] pre-push: no ref updates (zero bytes on stdin); N/A."
elif ! DOCOPS_CHECKER="$(resolve_docops_checker)"; then
  echo "[pre-push] scripts/docops.py not found in this or the main worktree; push blocked."
  echo "[pre-push] Materialize the ToolTempest core component. From a ToolTempest checkout that contains the commit pinned in .tooltempest.lock, run:"
  echo "[pre-push]   python3 <tooltempest-checkout>/scripts/tooling.py materialize --root '$REPO_ROOT' --source <tooltempest-checkout> --apply"
  echo "[pre-push] Procedure: docs/tooltempest/consumer-contract.md in mikkiola/tooltempest."
  exit 1
elif ! python3 "$DOCOPS_CHECKER" check --repo "$REPO_ROOT" --push-stdin < "$PUSH_CAPTURE"; then
  echo "[pre-push] docops check failed; push blocked."
  exit 1
fi

echo "[pre-push] All checks passed."
exit 0
